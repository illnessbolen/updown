# Copy to .env. Every setting in latarb/config.py can be set here; out-of-range values abort the start.
ASSETS=btc,eth,sol,xrp,doge,bnb
EDGE_THRESHOLD=0.03
EXPECTED_SLIPPAGE=0.005
TAIL_DOF=5
MIN_TIME_LEFT_S=3
DATA_DIR=data
RECORD_TICKS=false
# network: "" = use HTTPS_PROXY/NO_PROXY, "none" = direct
WS_PROXY=
# BINANCE_WS_URL=wss://data-stream.binance.vision/stream
LOG_LEVEL=INFO
