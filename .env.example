# Copy to .env. Every setting in latarb/config.py can be set here; out-of-range values abort the start.
ASSETS=btc,eth,sol,xrp,doge,bnb
EDGE_THRESHOLD=0.03
EXPECTED_SLIPPAGE=0.005
TAIL_DOF=5
# volatility at 1 s plus these sampling scales; each window uses the scale closest to its time left
VOL_SCALES_S=10,60
# trade only mispricings explained by a recent spot move the market has not priced yet
REQUIRE_LATENCY_EXPLANATION=true
LATENCY_LOOKBACKS_S=1,2,3,5
LATENCY_MATCH_TOL=0.04
MIN_TIME_LEFT_S=3
DATA_DIR=data
RECORD_TICKS=false
# network: "" = use HTTPS_PROXY/NO_PROXY, "none" = direct
WS_PROXY=
# BINANCE_WS_URL=wss://data-stream.binance.vision/stream
LOG_LEVEL=INFO

# --- paper execution & risk (profiles and hard bounds: latarb/risk/limits.py) ---
RISK_PROFILE=conservative
# RISK_BET_PCT=0.01          # overrides must stay inside the hard bounds or the bot refuses to start
EXECUTION_STYLE=maker_first
LATENCY_BUDGET_MS=300
BOOK_MAX_AGE_MS=1500
PRE_TRADE_REFRESH=rest
PAPER_START_USDC=1000
COOLDOWN_AFTER_LOSS_S=300
MAX_CONSECUTIVE_ERRORS=5
KILL_SWITCH_FILE=STOP
